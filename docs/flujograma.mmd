%% Flujograma del pipeline rs-pipeline (se actualiza al cerrar cada bloque).
%% Estado: bloques 1 (PRISMA), 2 (normalización), 3 (descriptivos), 4 (exclusiones por nivel) y 5 (mini-sprint semántico) cerrados.
%% Formas: paralelogramo = entrada; rectángulo = proceso/script; rombo = decisión o control;
%%         documento = salida; estadio rojo = falla. Frontera: el Drive es SOLO LECTURA.
flowchart TB

  subgraph DRIVE["GOOGLE DRIVE — SOLO LECTURA (nada se escribe aquí)"]
    direction TB
    dB[/"01_busquedas<br/>Registro_busquedas_PRISMA_v3.md<br/>fuentes: 1.105 + 122 = 1.227 (declarado)"/]
    dC[/"02_cribado<br/>Cribado_titulo_resumen_2026-10-06.csv<br/>1.103 registros"/]
    dR[/"03_recuperacion<br/>Recuperacion_textos_completos_2026-10-10.csv<br/>432 informes"/]
    dP[/"03_recuperacion/artículos_pdf/_no_corresponde<br/>15 PDF de otro documento"/]
    dE[/"04_elegibilidad<br/>Elegibilidad v3 (307 filas, con año)<br/>Casos dudosos v4 (121 filas)"/]
    dX[/"05_extraccion<br/>Extraccion_datos_v2_2026-10-18.csv<br/>219 filas × 58 columnas"/]
    dT[/"_trabajo/ext/txt<br/>texto completo de 10 informes<br/>(solo Prueba 1)"/]
    dJ[/"06_prisma<br/>prisma_counts_2026-10-26.json<br/>conteos base (201 informes)"/]
  end

  subgraph REPO["REPOSITORIO rs-pipeline — aquí sí se escribe"]
    direction TB

    subgraph CFG["Configuración (en git)"]
      direction LR
      env[/".env<br/>RS_DRIVE_ROOT (fuera de git)"/]
      cfgP[/"config/params.yaml<br/>config/reclasificaciones.yaml<br/>6 reclasificaciones D→E2"/]
      cfgC[/"config/categorias.yaml<br/>mapeo aprobado D17–D33<br/>(país, nivel, nivel_dudoso)"/]
      cfgS[/"params (semantico) · stopwords<br/>requirements-semantico.txt (.venv-semantico)<br/>modelos HF con revisión fija"/]
      cfgE[/"config/exclusiones_nivel.yaml<br/>5 exclusiones (4 E1, 1 E3) D33"/]
      cfgV[/"config/prisma_counts_2026-10-29.json<br/>196 informes · 193 estudios<br/>(en el repo; el del Drive no se toca)"/]
    end

    subgraph B1["BLOQUE 1 · Conteos PRISMA y diagrama — prisma_02.py"]
      direction TB
      p0["Lee CSV, JSON y Registro<br/>(solo lectura) y calcula hashes"]
      k0{"¿Archivos, columnas<br/>e IDs completos y únicos?"}
      dv["prisma_02 --derivar-counts<br/>base del Drive + 5 exclusiones<br/>→ versión nueva en el repo"]
      p1["Aplica las 6 reclasificaciones y las<br/>5 exclusiones de nivel; recalcula los conteos"]
      k1{"¿Conteos de los CSV = JSON?<br/>1.103 → 432 → 295 → 196<br/>¿suma cada etapa?"}
      k2{"¿196 informes = 193 estudios (3 pares)?<br/>¿ninguna exclusión rompe un par?<br/>¿15 PDF respaldados?<br/>¿fuentes suman 1.227?"}
      p2["Construye el diagrama con prisma-flow<br/>(textos en español, sin título)"]
      o1@{ shape: doc, label: "outputs/figuras/<br/>Diagrama_PRISMA_2020_Eje3_2026-10-26<br/>.svg · .png · .json (trazabilidad)" }
    end

    subgraph B2["BLOQUE 2 · Normalización de la matriz — normalizar_01.py"]
      direction TB
      n0["Lee matriz v2 y dudosos;<br/>quita los 18 E4 de los dudosos"]
      m1{"¿201 − exclusiones de nivel = 196<br/>= prisma_counts vigente?"}
      n1["Aplica config/categorias.yaml<br/>23 columnas nuevas (nivel_dudoso, excluido_nivel);<br/>originales intactas; los 5 excluidos se marcan, no se borran<br/>(nivel según el texto del informe)"]
      m2{"¿Todo valor crudo está en el mapeo?<br/>¿las reglas de excepción tocan<br/>exactamente lo aprobado?"}
      o2@{ shape: doc, label: "data/processed/ (fuera de git)<br/>Extraccion_datos_v2_2026-10-18_normalizada.csv + .json<br/>81 columnas · 201 filas (196 incluidas)" }
    end

    subgraph B3["BLOQUE 3 · Descriptivos — descriptivos_03.py"]
      direction TB
      q0["Lee la matriz normalizada, su registro<br/>y el año de la base de datos (elegibilidad);<br/>filtra los 5 excluidos por nivel"]
      r1{"¿Hash de la matriz = el registrado?<br/>¿193 estudios? ¿mismo atributo en los informes<br/>de un estudio? ¿año en la ventana 2021–2026?"}
      q1["Calcula frecuencias: n y %<br/>base 196 informes; 193 estudios donde aplica"]
      q2["Lista los 32 informes cuyo nivel toca<br/>la elegibilidad, con la decisión de Luis Fer"]
      o3@{ shape: doc, label: "outputs/tablas/<br/>11 tablas .csv + .json<br/>(196 informes · 193 estudios)" }
      o4@{ shape: doc, label: "outputs/tablas/revision_elegibilidad_nivel.csv<br/>LOCAL, no versionado (D30); .json sí<br/>32 informes; decision_luisfer completa (D33)<br/>27 incluir · 4 E1 · 1 E3" }
    end

    subgraph B5["BLOQUE 5 · Mini-sprint semántico — semantico_04.py (venv aparte, local)"]
      direction TB
      s0["Fichas de 196 informes (3.608 unidades; 2b: 2.176) y<br/>trozos de 10 informes (408 / 624)<br/>sin referencias ni encabezados"]
      w1{"¿matriz = hash registrado y 196 informes?<br/>¿referencias cortadas? ¿textos existen?"}
      s1["Embeddings e5-base y MiniLM (MPS)<br/>BERTopic: 5 semillas × 2 modelos × 3 pruebas"]
      w2{"¿ARI entre semillas ≥ 0,6? ¿sin tema ≤ 40 %?<br/>¿NPMI real > azar? ¿temas de un documento ≤ 50 %?"}
      s2["Hoja a ciegas P2b: 35 temas con código aleatorio<br/>Luis Fer califica: 29 interpretables · 6 mixtos · 0 ruido"]
      w3{"¿≥ 60 % interpretables?"}
      o5@{ shape: doc, label: "outputs/semantico_metricas/ (solo números, en git)<br/>P1 texto completo: no sirve · P2b fichas oe2: sigue" }
      o6@{ shape: doc, label: "outputs/semantico/ (LOCAL, ignorado)<br/>hoja a ciegas · traducción · asignaciones" }
    end

    subgraph B6["BLOQUE 6 · Marco de criterios v0 y evidencia — criterios_05.py (venv semántico, local)"]
      direction TB
      h0["Hoja para nombrar los 20 temas de e5 (P2b, semilla 4)<br/>Luis Fer nombra a ciegas; Claude propone aparte (acuerdo 8 de 9)"]
      cfgK[/"config/criterios_v0.yaml (en git)<br/>9 criterios C01–C09 · D42<br/>C01 y C09 en borrador"/]
      k0["Cruce criterio × unidades, informes y estudios<br/>peso A MMAT + B diseño + C pertinencia (suma y mínimo)<br/>sensibilidad sin peso bajo · dirección · nivel · disciplina<br/>separa «no reporta» (D43) · 5 candidatos por similitud e5"]
      k1{"¿matriz = hash, 196 informes / 193 estudios?<br/>¿asignaciones = unidades? ¿5 ítems MMAT por informe?"}
      o7@{ shape: doc, label: "outputs/tablas/ (en git, solo números)<br/>criterios_v0_evidencia · reporte_por_campo<br/>mmat_items_por_informe + .json" }
      o8@{ shape: doc, label: "outputs/semantico/ (LOCAL, ignorado)<br/>IDs · ejemplos · 5 candidatos por criterio" }
    end

    subgraph B7["BLOQUE 7 · Libro de códigos y piloto — codificacion_06.py (sin API)"]
      direction TB
      l0["Libro de códigos v0 (escala 0 / 1 / 2) desde criterios_v0<br/>19 campos de ficha, sin oe2_criterios_candidatos ni lf_*<br/>sin marcas [F]/[I] ni citas de página"]
      l1{"¿C01–C09 en orden? ¿columnas de la ficha?<br/>¿piloto variado? ¿hoja sin códigos previos?"}
      o9@{ shape: doc, label: "config/libro_codigos_v0.yaml · docs/libro_codigos_v0.md<br/>outputs/tablas/costo_codificacion_estimado.json (en git)" }
      o10@{ shape: doc, label: "outputs/semantico/ (LOCAL, ignorado)<br/>hoja piloto P01–P05 · correspondencia<br/>muestra de confiabilidad (40)" }
    end

    f1(["FALLA<br/>mensaje claro y código 1<br/>no dibuja nada"])
    f2(["FALLA<br/>mensaje claro y código 1<br/>no escribe la matriz"])
    f3(["FALLA<br/>mensaje claro y código 1<br/>no escribe tablas"])
    f4(["FALLA<br/>mensaje claro y código 1<br/>no corre el sprint"])
    f5(["FALLA<br/>mensaje claro y código 1<br/>no escribe el cruce"])
    f6(["FALLA<br/>mensaje claro y código 1<br/>no escribe la hoja"])
  end

  %% Entradas del bloque 1 (frontera: solo lectura)
  dB --> p0
  dC --> p0
  dR --> p0
  dP --> p0
  dE --> p0
  dX --> p0
  dJ --> dv
  dX --> dv
  cfgE --> dv
  dv --> cfgV
  cfgV --> p0
  cfgE --> p1
  env --> p0
  cfgP --> p0

  p0 --> k0
  k0 -- "sí" --> p1
  k0 -- "no" --> f1
  p1 --> k1
  k1 -- "sí" --> k2
  k1 -- "no" --> f1
  k2 -- "sí" --> p2
  k2 -- "no" --> f1
  p2 --> o1

  %% Bloque 2
  dX --> n0
  dE --> n0
  cfgV --> n0
  cfgE --> n0
  cfgC --> n0
  env --> n0
  n0 --> m1
  m1 -- "sí" --> n1
  m1 -- "no" --> f2
  n1 --> m2
  m2 -- "sí" --> o2
  m2 -- "no" --> f2

  %% Bloque 3
  o2 --> q0
  dE --> q0
  cfgV --> q0
  cfgP --> q0
  q0 --> r1
